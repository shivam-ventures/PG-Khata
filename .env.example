# Supabase project config — same backend project as before the Flutter
# pivot; only the client that reads these values changes. Create a project
# at https://supabase.com, then Project Settings > API.
#
# The Flutter app will read these via `flutter_dotenv` (a `mobile/.env`
# file) or `--dart-define-from-file`, not the NEXT_PUBLIC_ prefix this
# project used pre-pivot — exact mechanism decided when auth is built.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Phone OTP auth needs a way to actually send the code:
#  - Cheapest for now: Authentication > Providers > Phone > "Test OTPs" —
#    add a line like +919999999999=123456 and sign in with that exact
#    number + code, no SMS provider account needed at all. Dev-only.
#  - For real users: configure a real SMS provider (MSG91 or Twilio) in the
#    same Phone provider settings — this is a real per-SMS cost once live.

# --- Added in later phases, not needed yet ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# WHATSAPP_BSP_API_KEY=       # e.g. AiSensy / Gupshup, added in the reminders phase
